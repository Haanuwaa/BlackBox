{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "BLACKBOX_BUILD_TESTS": "ON",
        "BLACKBOX_SOURCE_REVISION": "auto"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "inherits": "windows-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-vs2026-debug",
      "displayName": "Windows Visual Studio 2026 Debug",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-vs2026-release",
      "displayName": "Windows Visual Studio 2026 Release",
      "inherits": "windows-vs2026-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-vs2026-address-sanitizer",
      "displayName": "Windows Visual Studio 2026 AddressSanitizer",
      "inherits": "windows-vs2026-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BLACKBOX_ENABLE_ADDRESS_SANITIZER": "ON",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_TARGET_TRIPLET": "x64-windows-blackbox-asan"
      }
    },
    {
      "name": "windows-vs2026-static-analysis",
      "displayName": "Windows Visual Studio 2026 Native Analysis",
      "inherits": "windows-vs2026-release",
      "cacheVariables": {
        "BLACKBOX_ENABLE_MSVC_CODE_ANALYSIS": "ON",
        "BLACKBOX_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "windows-vs2026-debug",
      "configurePreset": "windows-vs2026-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026-release",
      "configuration": "Release"
    },
    {
      "name": "windows-vs2026-address-sanitizer",
      "configurePreset": "windows-vs2026-address-sanitizer",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-vs2026-static-analysis",
      "configurePreset": "windows-vs2026-static-analysis",
      "configuration": "Release",
      "targets": ["blackbox", "blackbox_tests"]
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-vs2026-debug",
      "configurePreset": "windows-vs2026-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-vs2026-address-sanitizer",
      "configurePreset": "windows-vs2026-address-sanitizer",
      "configuration": "RelWithDebInfo",
      "filter": {
        "exclude": {
          "name": "Windows unhandled exception probe"
        }
      },
      "output": { "outputOnFailure": true }
    }
  ],
  "packagePresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "generators": ["ZIP"],
      "configurations": ["Release"]
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026-release",
      "generators": ["ZIP"],
      "configurations": ["Release"]
    }
  ]
}
